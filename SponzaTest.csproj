<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <Compile Remove="Tests/**/*.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="SDL3-CS" Version="3.4.18.1" />
        <PackageReference Include="SDL3-CS.Linux" Version="3.4.18.1" />

        <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
        <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Resources\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <Target Name="CompileShaders" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
        <Exec Command="call &quot;$(MSBuildProjectDirectory)\Resources\Shaders\compile.bat&quot;" WorkingDirectory="$(MSBuildProjectDirectory)/Resources/Shaders" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
        <Exec Command="bash &quot;$(MSBuildProjectDirectory)/Resources/Shaders/compile.sh&quot;" WorkingDirectory="$(MSBuildProjectDirectory)/Resources/Shaders" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />

        <ItemGroup>
            <None Remove="Resources/Shaders/Compiled/**/*" />
            <None Include="Resources/Shaders/Compiled/**/*" CopyToOutputDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

    <Target Name="CleanShaders" AfterTargets="Clean">
        <RemoveDir Directories="$(MSBuildProjectDirectory)/Resources/Shaders/Compiled" />
    </Target>

</Project>
